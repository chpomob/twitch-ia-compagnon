        "epistemic_label_defaulted"
      ]
    },
    {
      "id": "A2",
      "severity": "major",
      "file": "core/config_ui/__init__.py",
      "line": 1237,
      "summary": "Account for delays between uptime and wall-clock sampling",
      "evidence": "The wall clock is sampled after reading uptime, so any intervening scheduling delay shifts the computed process start forward by that delay. If a genuine publisher wrote its record 100 ms after starting and this reader is descheduled for 200 ms between these samples, record_pid_live() incorrectly declares it stale. claim_instance() then deletes the active instance's record without probing it. Pair or bracket the clock samples and handle uncertain measurements before applying the strict comparison.",
      "confidence": "low",
      "basis": "inference",
